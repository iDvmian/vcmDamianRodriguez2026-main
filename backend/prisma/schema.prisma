generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  ADMIN
  GESTOR_VCM
  ENCARGADO_CARRERA
  DOCENTE
  DECANO
  DIRECTOR_VCM
  CLIENTE
}

enum TipoCosto {
  INGRESO
  GASTO
}

enum EtapaSeguimiento {
  SOLICITUD_CREADA
  SOLICITUD_APROBADA
  SOLICITUD_RECHAZADA
  PLANTEAMIENTO_CREADO
  PLANTEAMIENTO_APROBADO
  PLANTEAMIENTO_RECHAZADO
  PLANTEAMIENTO_REENVIADO
  PROYECTO_CREADO
  PROYECTO_EN_PROCESO
  PROYECTO_PAUSADO
  PROYECTO_FINALIZADO
  PROYECTO_CANCELADO
}

enum OrigenSolicitud {
  EXTERNA
  DOCENTE
}

/// Alcance territorial de la vinculación (Política de Vinculación con el Medio)
enum AlcanceVinculacion {
  REGIONAL
  NACIONAL
  INTERNACIONAL
}

enum TipoCliente {
  JUNTA_VECINOS
  ONG
  ESTABLECIMIENTO_EDUCACIONAL
  EMPRESA_PRIVADA
  ORGANISMO_PUBLICO
  PERSONA_NATURAL
  OTRO
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum EstadoPlanteamiento {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum EstadoProyecto {
  EN_PROCESO
  PAUSADO
  FINALIZADO
  CANCELADO
}

enum UnidadDuracion {
  DIAS
  SEMANAS
  MESES
}

enum TipoIntervencion {
  CHARLA
  TALLER
  CURSO_CAPACITACION
  SEMINARIO
  ASESORIA_TECNICA
  OPERATIVO_TERRENO
  APRENDIZAJE_SERVICIO
  ACTIVIDAD_CULTURAL
  VOLUNTARIADO
  INVESTIGACION_APLICADA
  OTRO
}

// ─── Modelos ─────────────────────────────────────────────────────────────────

model User {
  id        Int      @id @default(autoincrement())
  rut       String   @unique
  nombres   String
  apellidos String
  email     String   @unique
  telefono  String?
  password  String
  rol       Role     @default(CLIENTE)
  estado    Boolean  @default(true)
  carreraId Int?
  carrera   Carrera? @relation(fields: [carreraId], references: [id])
  /// Facultad a la que pertenece un Decano: solo ve la información de esa facultad
  facultadId Int?
  facultad   Facultad? @relation("DecanoFacultad", fields: [facultadId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  solicitudesComoCliente    Solicitud[]     @relation("ClienteSolicitud")
  planteamientosComoDocente Planteamiento[] @relation("DocentePlanteamiento")
  historialEtapas           HistorialEtapa[] @relation("UsuarioHistorial")
  observacionesComoAutor    Observacion[]   @relation("AutorObservacion")
  passwordResetTokens       PasswordResetToken[]
}

/// Token de un solo uso para restablecer la contraseña (se guarda solo su hash SHA-256)
model PasswordResetToken {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

model Facultad {
  id        Int       @id @default(autoincrement())
  nombre    String
  etiqueta  String    @unique
  carreras  Carrera[]
  decanos   User[]    @relation("DecanoFacultad")
  planesEstrategicos PlanEstrategico[]
  programas Programa[]
  solicitudes Solicitud[]
  createdAt DateTime  @default(now())
}

model Carrera {
  id         Int                @id @default(autoincrement())
  nombre     String
  etiqueta   String             @unique
  facultadId Int
  facultad   Facultad           @relation(fields: [facultadId], references: [id])
  usuarios   User[]
  alumnos    AlumnoVoluntario[]
  solicitudes Solicitud[]
  createdAt  DateTime           @default(now())
}

model AlumnoVoluntario {
  id        Int              @id @default(autoincrement())
  rut       String           @unique
  nombres   String
  apellidos String
  email     String           @unique
  telefono  String?
  carreraId Int
  carrera   Carrera          @relation(fields: [carreraId], references: [id])
  estado    Boolean          @default(true)
  proyectos ProyectoAlumno[]
  createdAt DateTime         @default(now())
}

/// Programas de Vinculación con el Medio de la universidad; toda solicitud se asocia a uno
model Programa {
  id          Int         @id @default(autoincrement())
  nombre      String      @unique @db.VarChar(200)
  descripcion String?     @db.Text
  /// Actividades clave del programa, una por línea
  actividades String?     @db.Text
  orden       Int         @default(0)
  activo      Boolean     @default(true)
  /// Facultad a la que pertenece el programa; null = programa de toda la universidad
  facultadId  Int?
  facultad    Facultad?   @relation(fields: [facultadId], references: [id], onDelete: SetNull)
  solicitudes Solicitud[]
}

model Solicitud {
  id          Int               @id @default(autoincrement())
  titulo      String
  descripcion String            @db.Text
  alcance     AlcanceVinculacion @default(REGIONAL)
  ciudad      String?
  region      String?           @db.VarChar(100)
  pais        String?           @db.VarChar(100)
  direccion   String?
  numeroDireccion String?
  telefono    String?
  estado      EstadoSolicitud   @default(PENDIENTE)
  motivoRechazo String?         @db.Text
  tipoCliente TipoCliente?
  tipoClienteOtro String?       @db.VarChar(100)
  origen      OrigenSolicitud   @default(EXTERNA)
  nombreOrganizacion String?    @db.VarChar(150)
  personasPrevistas  Int?
  carreraId   Int?
  carrera     Carrera?          @relation(fields: [carreraId], references: [id])
  programaId  Int?
  programa    Programa?         @relation(fields: [programaId], references: [id])
  /// Facultad a la que se dirige la solicitud (la del programa, o la elegida si no encaja en ninguno)
  facultadId  Int?
  facultad    Facultad?         @relation(fields: [facultadId], references: [id])
  clienteId   Int
  cliente     User              @relation("ClienteSolicitud", fields: [clienteId], references: [id])
  archivos    ArchivoSolicitud[]
  planteamiento Planteamiento?
  historial   HistorialEtapa[]
  /// Fecha en que se avisó que esta iniciativa será depurada por antigüedad (retención de 5 años)
  avisoRetencionEn DateTime?
  /// Mientras el solicitante tiene abierta la edición, hasta cuándo vale ese "editando" (se renueva cada ~30 s)
  editandoHasta DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model ArchivoSolicitud {
  id          Int       @id @default(autoincrement())
  url         String
  publicId    String
  nombre      String
  solicitudId Int
  solicitud   Solicitud @relation(fields: [solicitudId], references: [id])
}

model Planteamiento {
  id             Int                   @id @default(autoincrement())
  descripcion    String                @db.Text
  tiempoEstimado String
  duracionCantidad      Int?
  duracionUnidad        UnidadDuracion?
  horasHombre           Int?
  tipoIntervencion      TipoIntervencion?
  tipoIntervencionOtro  String?
  estado         EstadoPlanteamiento   @default(PENDIENTE)
  motivoRechazo  String?               @db.Text
  solicitudId    Int                   @unique
  solicitud      Solicitud             @relation(fields: [solicitudId], references: [id])
  docenteId      Int
  docente        User                  @relation("DocentePlanteamiento", fields: [docenteId], references: [id])
  archivos       ArchivoPlanteamiento[]
  proyecto       Proyecto?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
}

model ArchivoPlanteamiento {
  id              Int           @id @default(autoincrement())
  url             String
  publicId        String
  nombre          String
  planteamientoId Int
  planteamiento   Planteamiento @relation(fields: [planteamientoId], references: [id])
}

model Proyecto {
  id              Int              @id @default(autoincrement())
  estado          EstadoProyecto   @default(EN_PROCESO)
  fechaInicio     DateTime
  fechaFin        DateTime
  participantesDocentes     Int?
  participantesEstudiantes  Int?
  participantesDocentesExternos Int?
  participantesAlumnosExternos  Int?
  participantesOtrosExternos    Int?
  planteamientoId Int              @unique
  planteamiento   Planteamiento    @relation(fields: [planteamientoId], references: [id])
  alumnos         ProyectoAlumno[]
  observaciones   Observacion[]
  archivos        ArchivoProyecto[]
  costos          CostoProyecto[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

/// Desglose de costos de un proyecto: cada fila es un ingreso (+) o un gasto (-). El monto se guarda siempre positivo.
model CostoProyecto {
  id         Int       @id @default(autoincrement())
  concepto   String    @db.VarChar(200)
  tipo       TipoCosto
  monto      Int
  fecha      DateTime  @default(now())
  proyectoId Int
  proyecto   Proyecto  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([proyectoId])
}

model ArchivoProyecto {
  id         Int      @id @default(autoincrement())
  url        String
  publicId   String
  nombre     String
  proyectoId Int
  proyecto   Proyecto @relation(fields: [proyectoId], references: [id])
  createdAt  DateTime @default(now())
}

model ProyectoAlumno {
  proyectoId Int
  alumnoId   Int
  proyecto   Proyecto         @relation(fields: [proyectoId], references: [id])
  alumno     AlumnoVoluntario @relation(fields: [alumnoId], references: [id])

  @@id([proyectoId, alumnoId])
}

model Observacion {
  id          Int      @id @default(autoincrement())
  descripcion String   @db.Text
  proyectoId  Int
  proyecto    Proyecto @relation(fields: [proyectoId], references: [id])
  autorId     Int
  autor       User     @relation("AutorObservacion", fields: [autorId], references: [id])
  createdAt   DateTime @default(now())
}

/// Seguimiento: una fila por cada hito de una iniciativa (solicitud -> planteamiento -> proyecto).
/// Solo se agregan registros; `aproximado` marca los reconstruidos a partir de createdAt/updatedAt.
model HistorialEtapa {
  id          Int              @id @default(autoincrement())
  solicitudId Int
  solicitud   Solicitud        @relation(fields: [solicitudId], references: [id], onDelete: Cascade)
  etapa       EtapaSeguimiento
  fecha       DateTime         @default(now())
  usuarioId   Int?
  usuario     User?            @relation("UsuarioHistorial", fields: [usuarioId], references: [id], onDelete: SetNull)
  aproximado  Boolean          @default(false)

  @@index([solicitudId, fecha])
  @@index([etapa, fecha])
}

/// Registro de las iniciativas eliminadas automáticamente al cumplir el plazo de retención.
/// No tiene relaciones: sobrevive al borrado de la solicitud y deja constancia de qué se eliminó y cuándo.
model RegistroDepuracion {
  id               Int      @id @default(autoincrement())
  solicitudId      Int
  titulo           String
  estadoFinal      String
  fechaCierre      DateTime
  archivosBorrados Int      @default(0)
  borradoEn        DateTime @default(now())

  @@index([borradoEn])
}

// ─── Plan de Desarrollo Estratégico (por facultad) ───────────────────────────
// Jerarquía: Plan → Eje → Objetivo global → (Objetivos específicos e Indicadores globales)

model PlanEstrategico {
  id         Int              @id @default(autoincrement())
  periodo    String           @db.VarChar(50)
  facultadId Int
  facultad   Facultad         @relation(fields: [facultadId], references: [id], onDelete: Cascade)
  /// Documento del PDE (PDF o Word) subido a Cloudinary
  archivoUrl      String?     @db.VarChar(500)
  archivoPublicId String?     @db.VarChar(255)
  archivoNombre   String?     @db.VarChar(255)
  ejes       EjeEstrategico[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([facultadId, periodo])
}

model EjeEstrategico {
  id          Int               @id @default(autoincrement())
  descripcion String            @db.Text
  planId      Int
  plan        PlanEstrategico   @relation(fields: [planId], references: [id], onDelete: Cascade)
  objetivos   ObjetivoGlobal[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([planId])
}

model ObjetivoGlobal {
  id            Int                   @id @default(autoincrement())
  descripcion   String                @db.Text
  ejeId         Int
  eje           EjeEstrategico        @relation(fields: [ejeId], references: [id], onDelete: Cascade)
  especificos   ObjetivoEspecifico[]
  indicadores   IndicadorGlobal[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([ejeId])
}

model ObjetivoEspecifico {
  id               Int               @id @default(autoincrement())
  descripcion      String            @db.Text
  objetivoGlobalId Int
  objetivoGlobal   ObjetivoGlobal    @relation(fields: [objetivoGlobalId], references: [id], onDelete: Cascade)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([objetivoGlobalId])
}

model IndicadorGlobal {
  id               Int            @id @default(autoincrement())
  descripcion      String         @db.Text
  /// Objetivo global institucional al que responde, ej: "UCM OG 2"
  referenciaUcm    String?        @db.VarChar(50)
  objetivoGlobalId Int
  objetivoGlobal   ObjetivoGlobal @relation(fields: [objetivoGlobalId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([objetivoGlobalId])
}
